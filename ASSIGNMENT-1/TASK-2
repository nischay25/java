import java.util.Scanner;

public class Task2 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        String[][] slots = new String[3][];
        slots[0] = new String[2];
        slots[1] = new String[3];
        slots[2] = new String[4];

        System.out.print("Enter vehicle number: ");
        String vehicleNo = sc.nextLine();

        System.out.print("Enter parking duration in minutes: ");
        int minutes = sc.nextInt();

        if (minutes < 0) {
            System.out.println("Invalid duration");
        } else {
            int hours = (minutes + 59) / 60;
            int fee = hours * 30;

            slots[0][0] = vehicleNo;

            System.out.println("Vehicle: " + slots[0][0]);
            System.out.println("Floors: " + slots.length);
            System.out.println("Billable hours: " + hours);
            System.out.println("Parking fee: Rs." + fee);
        }

        sc.close();
    }
}
