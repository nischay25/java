abstract class Vehicle12 {
    protected String regNo;

    Vehicle12(String regNo) {
        this.regNo = regNo;
    }

    abstract double calculateFee(int hours);
}

class Car12 extends Vehicle12 {
    Car12(String regNo) {
        super(regNo);
    }

    @Override
    double calculateFee(int hours) {
        return hours * 30.0;
    }
}

class EBike12 extends Vehicle12 {
    EBike12(String regNo) {
        super(regNo);
    }

    @Override
    double calculateFee(int hours) {
        return 20.0;
    }
}

class DeliveryVan12 extends Vehicle12 {
    DeliveryVan12(String regNo) {
        super(regNo);
    }

    double calculateFee(int hours, boolean peakHours) {
        double rate = peakHours ? 60.0 : 30.0;
        return hours * rate;
    }

    @Override
    double calculateFee(int hours) {
        return calculateFee(hours, false);
    }
}

class VisitorPass12 {
    private final boolean valid;

    VisitorPass12(boolean valid) {
        this.valid = valid;
    }

    double applyPass(double fee) {
        return valid ? 0.0 : fee;
    }
}

public class Task12 {
    public static void main(String[] args) {
        int[] capacity = {20, 30, 40, 50, 60};
        String[][] slots = new String[capacity.length][];

        for (int i = 0; i < capacity.length; i++) {
            slots[i] = new String[capacity[i]];
        }

        Vehicle12 car = new Car12("TN01AB1111");
        Vehicle12 bike = new EBike12("TN02CD2222");
        DeliveryVan12 van = new DeliveryVan12("TN03EF3333");

        System.out.println("Car fee: Rs." +
                car.calculateFee(2));
        System.out.println("E-bike fee: Rs." +
                bike.calculateFee(2));
        System.out.println("Van fee (10 AM): Rs." +
                van.calculateFee(2, true));
        System.out.println("Van fee (7 PM): Rs." +
                van.calculateFee(2, false));

        VisitorPass12 pass = new VisitorPass12(true);
        System.out.println("Visitor fee with valid pass: Rs." +
                pass.applyPass(60));

        System.out.println("Number of floors: " + slots.length);
    }
}
