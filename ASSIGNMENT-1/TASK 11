import java.util.HashMap;
import java.util.Map;

class ParkingSystem11 {
    private final String[][] slots;
    private final Map<String, Integer> activeVehicles =
            new HashMap<>();

    ParkingSystem11(int[] capacity) {
        slots = new String[capacity.length][];
        for (int i = 0; i < capacity.length; i++) {
            slots[i] = new String[capacity[i]];
        }
    }

    boolean park(String regNo) {
        if (regNo == null || regNo.trim().isEmpty()
                || activeVehicles.containsKey(regNo)) {
            System.out.println("Invalid or duplicate vehicle");
            return false;
        }

        for (int f = 0; f < slots.length; f++) {
            for (int s = 0; s < slots[f].length; s++) {
                if (slots[f][s] == null) {
                    slots[f][s] = regNo;
                    activeVehicles.put(regNo, f * 1000 + s);
                    System.out.println(regNo + " parked at "
                            + f + "," + s);
                    return true;
                }
            }
        }

        System.out.println("Parking full");
        return false;
    }

    int calculateFee(int minutes, int rate) {
        if (minutes < 0 || rate < 0)
            throw new IllegalArgumentException("Invalid input");

        return ((minutes + 59) / 60) * rate;
    }

    boolean exit(String regNo) {
        Integer position = activeVehicles.remove(regNo);

        if (position == null) {
            System.out.println("Vehicle not found");
            return false;
        }

        int floor = position / 1000;
        int slot = position % 1000;
        slots[floor][slot] = null;

        System.out.println(regNo + " exited");
        return true;
    }
}

public class Task11 {
    public static void main(String[] args) {
        ParkingSystem11 p = new ParkingSystem11(
                new int[]{2, 1});

        p.park("TN01AB1111");
        p.park("TN02CD2222");
        p.park("TN01AB1111");

        System.out.println("Fee: Rs." +
                p.calculateFee(61, 30));

        p.exit("TN01AB1111");
        p.exit("TN09ZZ9999");

        p.park("TN03EF3333");
    }
}
